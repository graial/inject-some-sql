<h1>Store</h1>

<%= form_with url: store_index_path, method: :get do %>
  <input type="text" name="q" value="<%= params[:q] %>">
  <input type="submit" value="Search">
<% end %>

<ul>
  <% cache @products do %>
    <% @products.each do |product| %>
      <% cache product do %>
        <%= render partial: "product", object: product %>
      <% end %>
    <% end %>
  <% end %>
</ul>
